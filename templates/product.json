. Ya estoy mirando qué más pedir.<\/p>"}},"testimonial_C7KbdC":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/UGC_3.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Lucía M.","title":"Se nota la calidad","content":"<p>Nada más recibirlo se nota que está bien hecho. Tiene un acabado bonito y se ve cuidado. Me gusta porque es cómodo pero a la vez se ve elegante. Lo recomiendo.<\/p>"}},"testimonial_WUHqjf":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/UGC_4.6.png","round_avatar":true,"show_rating":true,"rating":4,"author":"Elena S.","title":"Cómodo y favorecedor","content":"<p>Buscaba algo sencillo pero bonito y ha sido un acierto. Queda bien sin esfuerzo y es muy cómodo de llevar. Perfecto para el día a día.<\/p>"}}},"block_order":["testimonial_9tRKr3","testimonial_Y8BFRX","testimonial_C7KbdC","testimonial_WUHqjf"],"name":"Testimonials","settings":{"full_width":true,"stack_testimonials":true,"subheading":"","title":"LO QUE DICE NUESTRA COMUNIDAD","content":"","link_url":"","link_text":"","background":"#f2f2f2","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","testimonial_card_background":"","testimonial_card_text_color":""}},"1764013233e3b67ebb":{"type":"apps","settings":{"full_width":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"background":"","background_gradient":"","text_color":""}},"related-products":{"type":"related-products","disabled":true,"settings":{"recommendations_count":6,"products":[],"full_width":true,"stack_products":true,"show_progress_bar":false,"products_per_row_mobile":"1","products_per_row_desktop":3,"subheading":"","title":"You may also like","content":"","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","product_card_background":"","product_card_text_color":""}},"1764011559f2f663f1":{"type":"apps","settings":{"full_width":true,"remove_vertical_spacing":false,"remove_horizontal_spaci